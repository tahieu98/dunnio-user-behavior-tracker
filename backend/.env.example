# =============================================
# Dunnio Behavior Tracker - Environment Config
# =============================================

# Server
PORT=3000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dunnio_tracker
DB_USER=root
DB_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h

# Microsoft Clarity
CLARITY_API_BASE_URL=https://www.clarity.ms
CLARITY_PROJECT_ID=your-clarity-project-id
CLARITY_API_TOKEN=your-clarity-jwt-token

# CORS
CORS_ORIGIN=http://localhost:3000

# Session
SESSION_SECRET=your-session-secret-change-in-production

# v1.1 measured tracker
HOST=127.0.0.1
ENABLE_DEMO=false
EVENT_RETENTION_DAYS=400
# Set a unique password of at least 12 characters only for admin:create, then remove it.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@dunnio-tracker.local
INITIAL_ADMIN_PASSWORD=

# v1.5 first-party touch collector
# Use 1 only behind exactly one trusted reverse proxy with no direct public app port.
TRUST_PROXY_HOPS=0
TOUCH_INGEST_LIMIT=120
# Optional absolute paths. Empty uses the app's local touch-archives folder.
TOUCH_ARCHIVE_DIR=
TOUCH_BACKUP_FOLDER=
# Linux Chromium path, optional; Windows normally uses installed Edge.
PLAYWRIGHT_EXECUTABLE_PATH=
