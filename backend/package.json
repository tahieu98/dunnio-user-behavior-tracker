{
  "name": "dunnio-behavior-tracker-backend",
  "version": "1.5.0",
  "description": "Backend API for Dunnio Tailor UI Behavior Tracker",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "migrate": "node src/migrate.js",
    "admin:create": "node src/createAdmin.js",
    "retention": "node src/retention.js",
    "capture": "node scripts/capture-page.js",
    "test": "node --test test/behavior.test.js test/catalog.test.js test/clarity-workspace.test.js test/clarity-workspace.integration.test.js test/integration.test.js",
    "test:browser": "playwright test",
    "test:browser:clarity": "playwright test -c clarity.playwright.config.js",
    "desktop:build": "powershell -NoProfile -ExecutionPolicy Bypass -File ../desktop/build-windows.ps1",
    "desktop:test": "powershell -NoProfile -ExecutionPolicy Bypass -File ../desktop/test-windows.ps1",
    "test:touch": "node --test test/touch.test.js test/touch-archive.test.js",
    "test:touch:db": "node --test test/touch.integration.test.js test/touch-archive.integration.test.js",
    "test:touch:e2e": "node --test test/touch.e2e.test.js",
    "test:touch:collector": "playwright test -c touch-collector.playwright.config.js",
    "test:touch:ui": "playwright test -c touch-ui.playwright.config.js",
    "touch:archive": "node scripts/touch-archive.js",
    "touch:maintenance": "node scripts/touch-maintenance.js",
    "touch:load": "node scripts/touch-load.js"
  },
  "keywords": [
    "clarity",
    "analytics",
    "tracker",
    "dunnio"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.1",
    "express-validator": "^7.0.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.6.5",
    "playwright-core": "^1.63.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0"
  }
}
