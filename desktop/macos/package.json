{
  "name": "dunnio-insights-macos",
  "productName": "Dunnio Insights",
  "version": "1.5.0",
  "description": "Dunnio Touch and Clarity Workspace for macOS",
  "author": "Dunnio",
  "license": "MIT",
  "main": "main.cjs",
  "scripts": {
    "test": "node --test test/*.test.cjs",
    "prepare:bundle": "node build.cjs",
    "build": "electron-builder --mac dmg zip --publish never",
    "smoke": "node smoke.cjs"
  },
  "devDependencies": {"electron": "44.7.0", "electron-builder": "26.15.3"},
  "build": {
    "appId": "com.dunnio.insights",
    "asar": true,
    "directories": {"output": "../../dist/macos"},
    "files": ["*.cjs", "configuration.html", "configuration.js", "package.json"],
    "extraResources": [
      {"from": "../../.local/macos-build/payload", "to": "app"},
      {"from": "../../.local/macos-build/vendor", "to": "vendor"},
      {"from": "../../.local/macos-build/licenses", "to": "licenses"},
      {"from": "USER-GUIDE.md", "to": "HUONG-DAN-MACOS.md"}
    ],
    "mac": {"category": "public.app-category.developer-tools", "minimumSystemVersion": "14.0", "identity": "-", "hardenedRuntime": false, "notarize": false, "target": ["dmg", "zip"]},
    "artifactName": "DunnioInsights-${version}-macos-${arch}.${ext}",
    "dmg": {"contents": [{"x": 130, "y": 180}, {"x": 410, "y": 180, "type": "link", "path": "/Applications"}]}
  }
}
